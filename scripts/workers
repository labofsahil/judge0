#!/bin/bash
# Start Sidekiq workers for background submission processing.
[[ -f /api/scripts/load-config ]] && source /api/scripts/load-config
[[ -f /judge0/scripts/load-config ]] && source /judge0/scripts/load-config
[[ -f ./scripts/load-config ]] && source ./scripts/load-config

QUEUE=${QUEUE,,} # Sidekiq requires lowercase queue names
COUNT=${COUNT:-$(( $(nproc) * 2 ))}

exec bundle exec sidekiq \
    --concurrency "$COUNT" \
    --queue "$QUEUE" \
    --queue default \
    --verbose
